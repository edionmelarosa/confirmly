{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @confirmly/db generate && pnpm --filter @confirmly/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @confirmly/db migrate:deploy && pnpm --filter @confirmly/api start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
