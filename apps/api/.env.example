DATABASE_URL=
SESSION_SECRET=
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# SMS_MODE controls whether SMS sends are live or logged only
# Values: "log" (no Semaphore calls, logs to stdout) | "live" (real Semaphore sends)
# Default: "live" if NODE_ENV=production, else "log"
SMS_MODE=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SENTRY_DSN=
