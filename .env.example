# Copy to .env and fill in per-environment. Never commit real values.

# packages/db — Postgres connection string (see packages/db/.env.example)
DATABASE_URL=

# apps/api — session cookie signing secret (Lucia)
SESSION_SECRET=

# apps/api — origin allowed to make credentialed CORS requests (the deployed web app's URL)
WEB_ORIGIN=

# apps/web — base URL of the deployed API, used by the browser client
NEXT_PUBLIC_API_URL=
