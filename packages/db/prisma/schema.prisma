generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchedulingMode {
  fixed_time
  session_capacity
}

enum SessionOfDay {
  am
  pm
}

enum RecurrenceRuleType {
  every_n_weeks
  day_of_month
}

enum RecurrenceRuleStatus {
  active
  paused
  cancelled
}

model Clinic {
  id                 String         @id @default(cuid())
  name               String
  timezone           String
  smsSenderName      String         @map("sms_sender_name")
  reminderLeadHours  Int            @default(24) @map("reminder_lead_hours")
  reminderLeadDays   Int            @default(1) @map("reminder_lead_days")
  subscriptionStatus String         @map("subscription_status")
  schedulingMode     SchedulingMode @default(fixed_time) @map("scheduling_mode")
  sessionCapacityAm  Int?           @map("session_capacity_am")
  sessionCapacityPm  Int?           @map("session_capacity_pm")
  sessionAmStartHour Int            @default(8) @map("session_am_start_hour")
  sessionAmEndHour   Int            @default(12) @map("session_am_end_hour")
  sessionPmStartHour Int            @default(13) @map("session_pm_start_hour")
  sessionPmEndHour   Int            @default(18) @map("session_pm_end_hour")
  // Business days as JS weekday numbers (0 = Sunday … 6 = Saturday), in the clinic's timezone.
  openDays           Int[]          @default([1, 2, 3, 4, 5, 6]) @map("open_days")
  openHour           Int            @default(8) @map("open_hour")
  closeHour          Int            @default(18) @map("close_hour")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  staffUsers       StaffUser[]
  patients         Patient[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  smsLogs          SmsLog[]
  recurrenceRules  RecurrenceRule[]
  accessTokens     AccessToken[]

  @@map("clinics")
}

model StaffUser {
  id           String   @id @default(cuid())
  clinicId     String   @map("clinic_id")
  email        String
  passwordHash String   @map("password_hash")
  role         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  sessions Session[]

  @@unique([clinicId, email])
  @@map("staff_users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Patient {
  id              String    @id @default(cuid())
  clinicId        String    @map("clinic_id")
  name            String
  phone           String
  scheduleType    String?   @map("schedule_type")
  scheduleDetails String?   @map("schedule_details")
  nextSchedule    DateTime? @map("next_schedule")
  service         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  recurrenceRules RecurrenceRule[]
  accessTokens    AccessToken[]

  @@unique([clinicId, phone])
  @@map("patients")
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  no_show
  completed
}

model Appointment {
  id                      String            @id @default(cuid())
  clinicId                String            @map("clinic_id")
  patientId               String            @map("patient_id")
  resourceId              String?           @map("resource_id")
  startsAt                DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime          @map("ends_at") @db.Timestamptz(3)
  status                  AppointmentStatus @default(scheduled)
  reminderSentAt          DateTime?         @map("reminder_sent_at")
  followUpOfAppointmentId String?           @map("follow_up_of_appointment_id")
  recurrenceRuleId        String?           @map("recurrence_rule_id")
  sessionOfDay            SessionOfDay?     @map("session_of_day")
  isSessionCapacity       Boolean           @default(false) @map("is_session_capacity")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  clinic                Clinic          @relation(fields: [clinicId], references: [id])
  patient               Patient         @relation(fields: [patientId], references: [id])
  followUpOfAppointment Appointment?    @relation("AppointmentFollowUp", fields: [followUpOfAppointmentId], references: [id])
  followUps             Appointment[]   @relation("AppointmentFollowUp")
  recurrenceRule        RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  smsLogs               SmsLog[]
  accessTokens          AccessToken[]

  @@index([clinicId, resourceId, startsAt])
  @@index([followUpOfAppointmentId])
  @@index([recurrenceRuleId])
  @@map("appointments")
}

model RecurrenceRule {
  id              String               @id @default(cuid())
  clinicId        String               @map("clinic_id")
  patientId       String               @map("patient_id")
  resourceId      String?              @map("resource_id")
  ruleType        RecurrenceRuleType   @map("rule_type")
  intervalWeeks   Int?                 @map("interval_weeks")
  dayOfMonth      Int?                 @map("day_of_month")
  durationMinutes Int                  @default(30) @map("duration_minutes")
  sessionOfDay    SessionOfDay?        @map("session_of_day")
  status          RecurrenceRuleStatus @default(active)
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  appointments Appointment[]

  @@index([clinicId, patientId])
  @@map("recurrence_rules")
}

enum WaitlistStatus {
  waiting
  offered
  claimed
  expired
  cancelled
}

model WaitlistEntry {
  id                String         @id @default(cuid())
  clinicId          String         @map("clinic_id")
  patientId         String         @map("patient_id")
  desiredStart      DateTime       @map("desired_start")
  desiredEnd        DateTime       @map("desired_end")
  status            WaitlistStatus @default(waiting)
  offeredResourceId String?        @map("offered_resource_id")
  offeredSlotStart  DateTime?      @map("offered_slot_start")
  offeredSlotEnd    DateTime?      @map("offered_slot_end")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  accessTokens AccessToken[]

  @@map("waitlist_entries")
}

enum AccessTokenPurpose {
  reschedule
  waitlist_claim
  manage
  invite_to_book
}

model AccessToken {
  id              String             @id @default(cuid())
  tokenHash       String             @unique @map("token_hash")
  purpose         AccessTokenPurpose
  appointmentId   String?            @map("appointment_id")
  waitlistEntryId String?            @map("waitlist_entry_id")
  patientId       String?            @map("patient_id")
  clinicId        String?            @map("clinic_id")
  expiresAt       DateTime           @map("expires_at")
  usedAt          DateTime?          @map("used_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])
  patient       Patient?       @relation(fields: [patientId], references: [id])
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])

  @@map("access_tokens")
}

enum SmsDirection {
  in
  out
}

model SmsLog {
  id                String       @id @default(cuid())
  clinicId          String       @map("clinic_id")
  direction         SmsDirection
  appointmentId     String?      @map("appointment_id")
  phone             String
  body              String
  providerStatus    String       @map("provider_status")
  providerMessageId String?      @map("provider_message_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("sms_logs")
}
